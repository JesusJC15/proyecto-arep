AREP_ENV=development
AREP_DATABASE_URL=sqlite:///data/arep_demo.sqlite3
AREP_JWT_SECRET=change-me-with-at-least-32-characters
AREP_JWT_ALGORITHM=HS256
AREP_ACCESS_TOKEN_TTL_MINUTES=60
AREP_SEED_DEMO_DATA=true
AREP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AREP_REQUEST_ID_HEADER=X-Request-ID
AREP_AUTH_RATE_LIMIT_COUNT=5
AREP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AREP_MUTATION_RATE_LIMIT_COUNT=20
AREP_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
AREP_ENABLE_METRICS=true
AREP_RAG_EMBEDDING_PROVIDER=local
AREP_RAG_EMBEDDING_MODEL=hashed-tfidf-v1
AREP_RAG_CHUNK_SIZE=90
AREP_RAG_CHUNK_OVERLAP=18
AREP_RAG_TOP_K=3
AREP_RAG_INDEX_ARTIFACT_PATH=artifacts/rag-index.json
AREP_RAG_CORPUS_VERSION=2026-05-phase3
AREP_RAG_FORCE_REINDEX=false
