    classDef actor fill:#F3F6FB,stroke:#355070,stroke-width:1px,color:#1B263B;
    classDef system fill:#EAFBF2,stroke:#2D6A4F,stroke-width:1px,color:#0B3D2E;
    classDef external fill:#FFF5E6,stroke:#BC6C25,stroke-width:1px,color:#6F4518;
    classDef future fill:#F7F7F7,stroke:#7A7A7A,stroke-dasharray: 4 3,color:#3E3E3E;

    class patient,professional actor;
    class platform system;
    class llm,kb external;
    class fhir future;
