flowchart LR
    patient["Paciente"]
    professional["Profesional de salud"]
    platform["Plataforma AREP\nTriaje asistido por evidencia"]
    llm["Proveedor LLM"]
    kb["Base de conocimiento clinica\nMarkdown curado"]
    fhir["Adaptador FHIR\nFase futura"]

    patient -->|"Registra sintomas y revisa recomendaciones"| platform
    professional -->|"Atiende casos escalados"| platform
    platform -->|"Genera recomendacion fundamentada"| llm
